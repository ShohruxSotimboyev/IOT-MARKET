PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/iot-market?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/iot-market?schema=public"

JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SESSION_SECRET=your_session_secret_here

# Frontend = 5174, Admin panel = 5173
FRONTEND_URL=http://localhost:5174
ADMIN_PANEL_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

STRIPE_SECRET_KEY=sk_test_your_stripe_key

BACKEND_URL=http://localhost:5000
